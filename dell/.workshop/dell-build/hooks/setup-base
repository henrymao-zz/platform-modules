#!/bin/bash
set -e

export DEBIAN_FRONTEND=noninteractive

add-apt-repository -y ppa:canonical-kernel-team/bootstrap

apt-get update

apt-get install -y \
    build-essential \
    debhelper \
    dh-python \
    python3 \
    python3-dev \
    python3-build \
    python3-venv \
    devscripts \
    fakeroot \
    lintian \
    dput

# Configure dput for PPA upload
cat > /home/ubuntu/.dput.cf << 'EOF'
[ubuntu-nos]
fqdn = ppa.launchpad.net
method = ftp
incoming = ~henrymao/ubuntu/ubuntu-nos
login = anonymous
allow_unsigned_uploads = 1
EOF

# Install SONiC kernel headers from the PPA
SONIC_KERNEL_VERSION="7.0.0-1002-sonic"
apt-get install -y "linux-headers-${SONIC_KERNEL_VERSION}"

echo "Installed SONiC kernel headers for ${SONIC_KERNEL_VERSION}"
echo "KVERSION can be set to '${SONIC_KERNEL_VERSION}' when building modules"
