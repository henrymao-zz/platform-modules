# postinst script for n3248pxe

# Enable Dell-n3248pxe-platform-service
depmod -a
systemctl enable platform-modules-n3248pxe.service
systemctl start platform-modules-n3248pxe.service
# Automatically added by dh_installmodules/13.31ubuntu1
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if [ -e /boot/System.map-7.0.0-1002-sonic ]; then
		depmod -a -F /boot/System.map-7.0.0-1002-sonic 7.0.0-1002-sonic || true
	fi
fi
# End automatically added section
# Automatically added by dh_installinit/13.31ubuntu1
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if [ -z "$DPKG_ROOT" ] && [ -x "/etc/init.d/platform-modules-n3248pxe" ]; then
		update-rc.d platform-modules-n3248pxe defaults >/dev/null
		if [ -n "$2" ]; then
			_dh_action=restart
		else
			_dh_action=start
		fi
		invoke-rc.d --skip-systemd-native platform-modules-n3248pxe $_dh_action || exit 1
	fi
fi
# End automatically added section

