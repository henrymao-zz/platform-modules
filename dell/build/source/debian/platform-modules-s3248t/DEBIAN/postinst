# postinst script for S3248T

# Enable Dell-S3248T-platform-service
depmod -a 
pip3 install /usr/share/sonic/device/x86_64-dell_s3248t-r0/sonic_platform-1.0-py3-none-any.whl --force-reinstall -q --root-user-action=ignore
systemctl enable platform-modules-s3248t.service
systemctl start platform-modules-s3248t.service
systemctl enable mux-ctrl.service
systemctl start --no-block mux-ctrl.service
# Automatically added by dh_installmodules/13.31ubuntu1
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if [ -e /boot/System.map-7.0.0-1002-sonic ]; then
		depmod -a -F /boot/System.map-7.0.0-1002-sonic 7.0.0-1002-sonic || true
	fi
fi
# End automatically added section
# Automatically added by dh_installinit/13.31ubuntu1
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if [ -z "$DPKG_ROOT" ] && [ -x "/etc/init.d/platform-modules-s3248t" ]; then
		update-rc.d platform-modules-s3248t defaults >/dev/null
		if [ -n "$2" ]; then
			_dh_action=restart
		else
			_dh_action=start
		fi
		invoke-rc.d --skip-systemd-native platform-modules-s3248t $_dh_action || exit 1
	fi
fi
# End automatically added section

