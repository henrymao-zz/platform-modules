INTERVAL=5
# The DEVPATHs below assume the pinned i2c bus numbering: the top-level
# PCA9548 fan/temp channel sits at bus 7 (see n3248te-modules.conf, which
# must load i2c-i801 before dell_n3248te_platform for this to hold).
DEVPATH=hwmon1=devices/pci0000:00/0000:00:12.0/i2c-0/i2c-7/7-002c hwmon2=devices/pci0000:00/0000:00:12.0/i2c-0/i2c-7/7-0049 hwmon3=devices/pci0000:00/0000:00:12.0/i2c-0/i2c-7/7-004a hwmon4=devices/pci0000:00/0000:00:12.0/i2c-0/i2c-7/7-004b
DEVNAME=hwmon1=emc2305 hwmon2=tmp75 hwmon3=tmp75 hwmon4=tmp75

# Fixed-speed mode: zones are always >= MAXTEMP(10C), so fancontrol pins
# each output at MAXPWM=153 (~59% duty / ~8000 RPM) regardless of temp.
FCTEMPS=hwmon1/pwm1=hwmon2/temp1_input hwmon1/pwm2=hwmon3/temp1_input hwmon1/pwm3=hwmon4/temp1_input
FCFANS=hwmon1/pwm1=hwmon1/fan1_input hwmon1/pwm2=hwmon1/fan2_input hwmon1/pwm3=hwmon1/fan3_input

MINTEMP=hwmon1/pwm1=0  hwmon1/pwm2=0 hwmon1/pwm3=0
MAXTEMP=hwmon1/pwm1=10  hwmon1/pwm2=10 hwmon1/pwm3=10

MINSTART=hwmon1/pwm1=100  hwmon1/pwm2=100 hwmon1/pwm3=100
MINSTOP=hwmon1/pwm1=152  hwmon1/pwm2=152 hwmon1/pwm3=152

MINPWM=hwmon1/pwm1=152  hwmon1/pwm2=152 hwmon1/pwm3=152
MAXPWM=hwmon1/pwm1=153  hwmon1/pwm2=153 hwmon1/pwm3=153
